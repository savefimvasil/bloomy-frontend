{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/garden/*":             ["../tily-packages/garden-planner/src/garden/*"],
      "@/calculator/*":         ["../tily-packages/garden-planner/src/calculator/*"],
      "~/lib/*":                ["../tily-packages/shared/lib/*"],
      "~/ui/*":                 ["../tily-packages/shared/ui/*"],
      "~/canvas/*":             ["../tily-packages/shared/canvas/*"],
      "~/mount-utils/*":        ["../tily-packages/shared/mount-utils/*"],
      "@/*":                    ["./*"],
      "@tily/tile-planner":     ["../tily-packages/tile-planner/dist/index"],
      "@bloomy/garden-planner": ["../tily-packages/garden-planner/dist/index"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "playwright-results", "playwright-report"]
}
